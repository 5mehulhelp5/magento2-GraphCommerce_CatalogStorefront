<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="GraphCommerce\CatalogStorefrontApi\Read\ProductDocumentsInterface">
        <plugin name="catalog_storefront_frontend_prices" type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Detail\PricesFromDocument"/>
    </type>
    <type name="Magento\CatalogRule\Observer\ProcessFrontFinalPriceObserver">
        <plugin name="catalog_storefront_frontend_catalog_rule" type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\Detail\CatalogRuleFromDocument"/>
    </type>
    <!-- The option labels a page shows, the attributes of a product page, the secondary info and the swatches. -->
    <type name="Magento\Eav\Model\Entity\Attribute\Source\Table">
        <plugin name="catalog_storefront_frontend_options" type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\OptionsFromDocuments" sortOrder="10"/>
    </type>
    <!-- The store label of every attribute a page shows: core keeps the labels it read for the life of the process. -->
    <type name="Magento\Eav\Model\Entity\Attribute">
        <plugin name="catalog_storefront_frontend_store_label" type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\StoreLabelFromDocuments" sortOrder="10"/>
    </type>
    <!-- The swatches a page shows: the product page, the cards of a listing and its layered navigation. -->
    <type name="Magento\Swatches\Helper\Data">
        <plugin name="catalog_storefront_frontend_swatches" type="GraphCommerce\CatalogStorefrontProductFrontend\Plugin\SwatchesFromDocuments" sortOrder="10"/>
    </type>
</config>
