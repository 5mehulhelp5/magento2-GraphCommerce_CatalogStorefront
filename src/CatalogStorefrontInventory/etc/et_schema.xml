<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <record name="StockItemStatus">
        <field name="isQtyDecimal" type="Boolean" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="itemQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="itemInStock" type="Boolean" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="qtyIncrements" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="enableQtyIncrements" type="Boolean" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="manageStock" type="Boolean" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="backorders" type="Int" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/><using field="stockId"/>
        </field>
        <field name="minQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
        <field name="minSaleQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
        <field name="maxSaleQty" type="Float" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockItem">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
        <field name="sources" type="StockItemSource" repeated="true" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockSources">
            <using field="sku"/>
            <using field="stockId"/>
        </field>
        <field name="websiteCodes" type="String" repeated="true" provider="GraphCommerce\CatalogStorefrontInventory\Model\DataExporter\Provider\StockWebsites">
            <using field="productId"/>
            <using field="stockId"/>
        </field>
    </record>
    <record name="StockItemSource">
        <field name="sourceCode" type="String"/>
        <field name="name" type="String"/>
        <field name="quantity" type="Float"/>
        <field name="inStock" type="Boolean"/>
        <field name="pickupLocation" type="Boolean"/>
        <field name="latitude" type="Float"/>
        <field name="longitude" type="Float"/>
        <field name="postcode" type="String"/>
        <field name="city" type="String"/>
        <field name="countryCode" type="String"/>
    </record>
</config>
