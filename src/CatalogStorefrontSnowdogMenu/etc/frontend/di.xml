<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Frontend only: the admin and GraphQL read the menu tables. A menu block reads its menu for the
         store view and for all store views, then its nodes. -->
    <type name="Snowdog\Menu\Api\MenuRepositoryInterface">
        <plugin name="graphcommerce_catalog_storefront_snowdog_menu_from_documents"
                type="GraphCommerce\CatalogStorefrontSnowdogMenu\Plugin\MenuFromDocuments"/>
    </type>
    <type name="Snowdog\Menu\Api\NodeRepositoryInterface">
        <plugin name="graphcommerce_catalog_storefront_snowdog_menu_nodes_from_documents"
                type="GraphCommerce\CatalogStorefrontSnowdogMenu\Plugin\NodesFromDocuments"/>
    </type>
    <!-- The node types that read: the category, product, CMS page and CMS block nodes. The custom url
         and wrapper nodes read nothing; a category child node reads its category and its children
         through the category plugins of GraphCommerce_CatalogStorefrontCategoryFrontend. -->
    <type name="Snowdog\Menu\Model\NodeType\Category">
        <plugin name="graphcommerce_catalog_storefront_snowdog_menu_category_nodes_from_documents"
                type="GraphCommerce\CatalogStorefrontSnowdogMenu\Plugin\CategoryNodesFromDocuments"/>
    </type>
    <type name="Snowdog\Menu\Model\NodeType\Product">
        <plugin name="graphcommerce_catalog_storefront_snowdog_menu_product_nodes_from_documents"
                type="GraphCommerce\CatalogStorefrontSnowdogMenu\Plugin\ProductNodesFromDocuments"/>
    </type>
    <type name="Snowdog\Menu\Model\NodeType\CmsPage">
        <plugin name="graphcommerce_catalog_storefront_snowdog_menu_cms_page_nodes_from_documents"
                type="GraphCommerce\CatalogStorefrontSnowdogMenu\Plugin\CmsPageNodesFromDocuments"/>
    </type>
    <type name="Snowdog\Menu\Model\NodeType\CmsBlock">
        <plugin name="graphcommerce_catalog_storefront_snowdog_menu_cms_block_nodes_from_documents"
                type="GraphCommerce\CatalogStorefrontSnowdogMenu\Plugin\CmsBlockNodesFromDocuments"/>
    </type>
</config>
