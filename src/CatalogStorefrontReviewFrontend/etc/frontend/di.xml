<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The review summary of a product page reads the summary row; the review documents give the summary. -->
    <type name="Magento\Review\Model\AppendSummaryData">
        <plugin name="graphcommerce_catalog_storefront_review_summary_from_documents"
                type="GraphCommerce\CatalogStorefrontReviewFrontend\Plugin\Detail\ReviewSummaryFromDocuments"/>
    </type>
</config>
