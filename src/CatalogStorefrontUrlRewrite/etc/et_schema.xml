<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_DataExporter:etc/et_schema.xsd">
    <!-- One row of the url rewrite table with its product category relation. Every column is a
         string as the table gives it, so a document holds the row core's storage reads. The
         provider runs the query of etc/query.xml in the form immediate export requires. -->
    <record name="Export">
        <field name="urlRewriteRows" type="UrlRewriteRow" repeated="true"
               provider="GraphCommerce\CatalogStorefront\Model\DataExporter\Processor\Scopes">
            <using field="urlRewriteId"/>
        </field>
    </record>
    <record name="UrlRewriteRow">
        <field name="urlRewriteId" type="ID"/>
        <field name="storeViewCode" type="String"/>
        <field name="entityType" type="String"/>
        <field name="entityId" type="String"/>
        <field name="requestPath" type="String"/>
        <field name="targetPath" type="String"/>
        <field name="redirectType" type="String"/>
        <field name="storeId" type="String"/>
        <field name="description" type="String"/>
        <field name="isAutogenerated" type="String"/>
        <field name="metadata" type="String"/>
        <field name="categoryId" type="String"/>
        <field name="productId" type="String"/>
    </record>
</config>
