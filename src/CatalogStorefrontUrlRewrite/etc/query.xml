<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_QueryXml:etc/query.xsd">
    <!-- A row of the admin store view is left out: no storefront request reads one. -->
    <query name="urlRewriteRows">
        <source name="url_rewrite">
            <attribute name="url_rewrite_id" alias="urlRewriteId"/>
            <attribute name="entity_type" alias="entityType"/>
            <attribute name="entity_id" alias="entityId"/>
            <attribute name="request_path" alias="requestPath"/>
            <attribute name="target_path" alias="targetPath"/>
            <attribute name="redirect_type" alias="redirectType"/>
            <attribute name="store_id" alias="storeId"/>
            <attribute name="description" alias="description"/>
            <attribute name="is_autogenerated" alias="isAutogenerated"/>
            <attribute name="metadata" alias="metadata"/>
            <link-source name="catalog_url_rewrite_product_category" link-type="left">
                <attribute name="category_id" alias="categoryId"/>
                <attribute name="product_id" alias="productId"/>
                <using glue="and">
                    <condition attribute="url_rewrite_id" operator="eq" type="identifier">url_rewrite_id</condition>
                </using>
            </link-source>
            <link-source name="store" link-type="inner">
                <attribute name="code" alias="storeViewCode"/>
                <using glue="and">
                    <condition attribute="store_id" operator="eq" type="identifier">store_id</condition>
                </using>
            </link-source>
            <filter glue="and">
                <condition attribute="url_rewrite_id" operator="in" type="placeholder">urlRewriteId</condition>
                <condition attribute="store_id" operator="neq" type="value">0</condition>
            </filter>
        </source>
    </query>
</config>
